# 首次启动可直接在 /setup 安装向导填写以下配置；本文件保留用于无人值守部署和默认值覆盖。
# 安装向导及「系统设置」会以 0600 权限原子更新项目根目录的 .env。

# ─── LDAP 配置 ────────────────────────────────────────────────────────────────
LDAP_DEFAULT_BIND_DN=cn=admin,dc=acdiost,dc=com
LDAP_DEFAULT_AUTHTOK_TYPE=password
LDAP_DEFAULT_AUTHTOK=
LDAP_URI=ldap://localhost
LDAP_BASE_DN=dc=acdiost,dc=com
LDAP_PORT=389
LDAP_USE_SSL=False
# LDAP TCP 连接和单次响应的硬超时（秒，范围 1–300）
LDAP_CONNECT_TIMEOUT_SECONDS=5
LDAP_RECEIVE_TIMEOUT_SECONDS=10

# ─── 应用设置 ──────────────────────────────────────────────────────────────────

# JSON 日志级别：DEBUG、INFO、WARNING、ERROR 或 CRITICAL
# 生产环境建议 INFO；所有写操作都会额外输出 event_type=audit 的审计记录
LOG_LEVEL=INFO

# 同一来源对同一账户连续失败 5 次后限制该组合 30 分钟；来源累计 20 次失败后限制来源
# 账户遭遇分布式失败时仅渐进延迟失败响应，正确凭据仍可从未受限来源登录
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
LOGIN_SOURCE_MAX_FAILED_ATTEMPTS=20
LOGIN_MAX_FAILURE_DELAY_SECONDS=5
# 多 worker 共享的 SQLite 状态；留空时使用项目 .runtime/login_attempts.sqlite3
LOGIN_LIMITER_DB_PATH=

# Session 密钥（生产环境请设置为随机长字符串）
# 至少 32 个随机字符，例如：openssl rand -hex 32
SECRET_KEY=

# 直接通过 HTTP 访问时保持 False；经 HTTPS 反向代理访问时设为 True
SESSION_HTTPS_ONLY=False

# 作业输出可读取的额外根目录，多个目录使用系统路径分隔符（Linux 为冒号）
# 用户在 LDAP 中配置的 Home 目录会自动加入允许范围
JOB_OUTPUT_ALLOWED_ROOTS=

# 作业 stdout/stderr 单次最多从文件尾部读取的字节数（默认 1 MiB，范围 1 KiB–16 MiB）
JOB_OUTPUT_MAX_BYTES=1048576

# 文件管理单个上传文件大小上限（MB，默认 1024）
FILE_UPLOAD_MAX_MB=1024
# 单个进程同时解析的上传请求数，以及每个上传请求的总处理超时（秒）
FILE_UPLOAD_MAX_CONCURRENT=2
FILE_UPLOAD_TIMEOUT_SECONDS=3600

# 在线文本编辑大小上限（KB，默认 2048；仅支持 UTF-8 文本）
FILE_EDIT_MAX_KB=2048

# xterm.js Web 终端。仅在认证开启时可用，Shell 始终以当前系统用户身份运行
TERMINAL_ENABLED=True

# 无输入和输出多少分钟后关闭会话；每个用户最多同时打开的会话数
TERMINAL_IDLE_MINUTES=30
TERMINAL_MAX_SESSIONS=2

# 终端 AI（支持 OpenAI/GLM/DeepSeek/vLLM/SGLang 兼容接口及 Claude Messages API）
# 管理员可在「系统设置」维护全局默认值；用户也可在终端内为当前连接临时覆盖
# 全局及会话 API Key 均不会回显；用户也可选择在浏览器中 AES-GCM 加密保存
TERMINAL_AI_ENABLED=False
TERMINAL_AI_PROVIDER=deepseek
TERMINAL_AI_BASE_URL=https://api.deepseek.com/v1
TERMINAL_AI_MODEL=deepseek-v4-flash
TERMINAL_AI_API_KEY=
TERMINAL_AI_TIMEOUT_SECONDS=60

# 新建 LDAP 用户时同步使用的默认 Slurm 账户
SLURM_DEFAULT_ACCOUNT=dawn

# 必填：当前 WebUI 管理的 Slurm ClusterName；所有 Association 写操作均以此限定范围
SLURM_CLUSTER_NAME=cluster

# 每条 Slurm CLI 命令的硬超时（秒，范围 1–300）
SLURM_COMMAND_TIMEOUT_SECONDS=15

# 生成 SSH 密钥的硬超时（秒，范围 1–300）
SSH_KEYGEN_TIMEOUT_SECONDS=30

# 节点和分区配置文件所在目录（node.conf、partition.conf）
# 默认：/etc/slurm
SLURM_CONFIG_DIR=/etc/slurm

# 调试开关：False = 跳过登录验证，方便本地调试；生产环境必须设为 True
AUTHORIZED=True

# ─── 管理员列表 ────────────────────────────────────────────────────────────────
# 多个管理员用英文逗号分隔，系统自动去重。
# 管理员可访问所有页面并操作所有资源；
# 普通用户仅可访问「作业管理」和外部链接，只能取消自己的作业。
#
# 示例：
#   ADMIN_USERS=admin
#   ADMIN_USERS=admin,dawn
#
# 也可通过「权限管理」页面在线修改，修改后立即生效，无需重启服务。
ADMIN_USERS=admin

# ─── NFS Quota 配置 ─────────────────────────────────────────────────────────
# 需要启用用户存储配额时配置（示例：/home 或 /data）
# 未配置则不执行 quota/setquota 调用
NFS_QUOTA_FS=
