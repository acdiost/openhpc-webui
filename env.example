# ─── LDAP 配置 ────────────────────────────────────────────────────────────────
LDAP_DEFAULT_BIND_DN=cn=admin,dc=acdiost,dc=com
LDAP_DEFAULT_AUTHTOK_TYPE=password
LDAP_DEFAULT_AUTHTOK=
LDAP_URI=ldap://localhost
LDAP_BASE_DN=dc=acdiost,dc=com
LDAP_PORT=389
LDAP_USE_SSL=False

# ─── 应用设置 ──────────────────────────────────────────────────────────────────

# Session 密钥（生产环境请设置为随机长字符串）
# 至少 32 个随机字符，例如：openssl rand -hex 32
SECRET_KEY=

# 直接通过 HTTP 访问时保持 False；经 HTTPS 反向代理访问时设为 True
SESSION_HTTPS_ONLY=False

# 作业输出可读取的额外根目录，多个目录使用系统路径分隔符（Linux 为冒号）
# 用户在 LDAP 中配置的 Home 目录会自动加入允许范围
JOB_OUTPUT_ALLOWED_ROOTS=

# 新建 LDAP 用户时同步使用的默认 Slurm 账户
SLURM_DEFAULT_ACCOUNT=dawn

# 节点和分区配置文件所在目录（node.conf、partition.conf）
# 默认：/etc/slurm
SLURM_CONFIG_DIR=/etc/slurm

# 调试开关：False = 跳过登录验证，方便本地调试；生产环境必须设为 True
AUTHORIZED=True

# ─── 管理员列表 ────────────────────────────────────────────────────────────────
# 多个管理员用英文逗号分隔，系统自动去重。
# 管理员可访问所有页面并操作所有资源；
# 普通用户仅可访问「作业管理」和外部链接，只能取消自己的作业。
#
# 示例：
#   ADMIN_USERS=admin
#   ADMIN_USERS=admin,dawn
#
# 也可通过「权限管理」页面在线修改，修改后立即生效，无需重启服务。
ADMIN_USERS=admin

# ─── NFS Quota 配置 ─────────────────────────────────────────────────────────
# 需要启用用户存储配额时配置（示例：/home 或 /data）
# 未配置则不执行 quota/setquota 调用
NFS_QUOTA_FS=
